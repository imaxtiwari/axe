# AXE environment configuration
# Copy this file to .env and fill in real values for local development.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/axe.db
SQLITE_WAL_MODE=true

# Vector store
CHROMA_PERSIST_DIR=./data/chroma

# Encryption (generate with scripts/generate_key.py)
ENCRYPTION_KEY=replace-with-a-base64url-fernet-key

# Azure Foundry LLM
AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_FOUNDRY_API_KEY=your-api-key
AZURE_FOUNDRY_MODEL=gpt-4o-mini

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Email (Resend example)
RESEND_API_KEY=re_your-resend-key
AXE_EMAIL_DOMAIN=axe.yourdomain.com
AXE_FROM_EMAIL=alerts@axe.test

# Alert destinations
ALERTS_SLACK_USER_ID=
ALERTS_EMAIL=

# Embedding provider (Azure Foundry / OpenAI compatible)
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SIMILARITY_THRESHOLD=0.72

# Polygon.io market data
POLYGON_API_KEY=your-polygon-key

# Google OAuth (Gmail / Calendar)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Fly.io / production secrets (only in deploy env)
FLY_APP_NAME=
SENTRY_DSN=
